    "vout_step_to_10ma_post_max_v": "maximum(((time>50u)&(time<80u))*v(vout)-(1-((time>50u)&(time<80u)))*1e3)",
    "vds_peak_pmos_during_step_v": "maximum(((time>40u)&(time<80u))*abs(v(xdut.a)-v(vout))-(1-((time>40u)&(time<80u)))*1e3)"
  },
  "checks": {
    "vout_step_to_10ma_post_min_v": {
      "min": 4.5
    },
    "vout_step_to_10ma_post_max_v": {
